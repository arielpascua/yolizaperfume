# TEST MODE. Set to exactly 1 and the order page (/checkout) offers ONLY a single PHP 10 test item (no volume
# discount, minimum order PHP 10), so a live payment can be proven for ten pesos. Remove the variable and the real
# catalogue is back, with no code change (Railway redeploys on a variable change). It is a REAL payment: the card is charged.
CHECKOUT_TEST_ITEM=
# Per-IP requests per minute. Blank means the defaults (checkout 20, enquiry 5).
CHECKOUT_RATE_LIMIT_PER_MIN=
ENQUIRY_RATE_LIMIT_PER_MIN=
# Order creation caps, per 10 minutes. Spent only by a genuine order about to be filed, never by junk. /checkout is open
# to everyone, and in card mode every order is a real payment attempt, so there is a per-source cap (blank = 5, read
# from a forwarding header, so it only raises the bar) and a GLOBAL cap (blank = 30, which cannot be spoofed).
CHECKOUT_IP_ORDERS_PER_10MIN=
CHECKOUT_ORDERS_PER_10MIN=
# Database: Railway Postgres. On Railway set this to a REFERENCE to the Postgres service, `${{Postgres.DATABASE_URL}}`,
# which resolves to the private network address (the database is then not exposed to the internet).
# Migrations (db/migrations) are applied automatically at every start (`npm start` runs scripts/start.mjs).
# Server only: never prefix it with NEXT_PUBLIC. Unset = no database (dev uses LOCAL_STORE_DIR; production answers 503).
DATABASE_URL=
# Local file store for orders and enquiries (development and e2e only). `npm run dev` defaults it to ./.data.
# A PRODUCTION build ignores it unless ALLOW_LOCAL_STORE=1 as well: never set that on a real deployment.
LOCAL_STORE_DIR=
ALLOW_LOCAL_STORE=
# Shown on the invoice-mode order confirmation (bank details, terms). Plain text; line breaks allowed.
PAYMENT_INSTRUCTIONS=

# --- Card payment: Hexacorp, LIVE ONLY (there is no sandbox mode) ---
# Unset or blank = INVOICE mode: orders are filed pending and a person sends an invoice.
# `hexacorp` = CARD mode: the buyer is sent to Hexacorp's hosted card page and the order is settled by the
# webhook / sweeper. Listing it here without the credentials below makes checkout answer 503; it never
# silently falls back to invoice mode. EVERY successful order in this mode is a REAL card charge.
PAYMENT_PROVIDERS=
# Issued by Hexacorp. All server-only: never prefix any of them with NEXT_PUBLIC_.
HEXACORP_APP_UUID=
HEXACORP_USERNAME=
HEXACORP_SECRET=
# Embedded in the callback URL handed to Hexacorp on every payment (/api/webhooks/hexacorp?k=...). Hexacorp
# documents no webhook signature, so this and an authenticated re-fetch are all that authenticate a delivery.
# 16+ characters.  Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HEXACORP_WEBHOOK_SECRET=
# Bearer secret for POST /api/admin/orders/reconcile (the scheduled sweeper). Unset = the route refuses everyone.
# Must equal the RECONCILE_SECRET repository secret used by .github/workflows/reconcile-payments.yml.
RECONCILE_SECRET=
# REQUIRED in card mode, in EVERY environment: the https origin of THIS deployment. The payment webhook URL is
# built from it; the request's own Host header is never trusted for that. To try card mode from a laptop, point
# it at a public https tunnel. (Replace the example value below.)
NEXT_PUBLIC_SITE_URL=https://yolizaperfume.example
# Shown in the footer when set; hidden when blank.
NEXT_PUBLIC_CONTACT_EMAIL=
